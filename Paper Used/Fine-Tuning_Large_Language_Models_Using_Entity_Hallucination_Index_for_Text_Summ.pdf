        const skip = /^\/(?:(?:cn|de|es|kr|it|fr|pt|pl|he|ru|ja|tr|ar)\/)?(?:wp-(?:content|admin|login\.php)|editor|authors|librarians|leadership|about|course-solutions|biopharma|newsroom|files|CDNSource|schools|Shibboleth)(?:\/|$)/i;

        // token check
        const hasToken = /(?:^|;\s*)jove-mptoken=/.test(document.cookie);

        if (!skip.test(path) && hasToken) {
            // replace www.* with app.* for preview + prod
            window.location.replace(window.location.href.replace(/\/\/www([.-]preview-\w{1,8}[.]test)?/, '//app$1'));
        }
        })();
